    <string name="welcome_title">Welcome to MH4U Builder</string>
    <string name="welcome_body">Builds the native code library for MH4U for Android from your own dump, right on the phone. Add code mods, rebuild, play. Nothing gets uploaded.</string>
    <string name="perm_title">Permissions</string>
    <string name="perm_body">File access lets the builder read your dump straight from storage and drop the library into your MH4U folder. Notifications show progress while you do something else.</string>
    <string name="all_files">All files access</string>
    <string name="notifications">Notifications</string>
    <string name="dump_title">Your dump</string>
    <string name="dump_body">Pick the decrypted v1.3.0 update (.cia). The base game (.3ds / .cci) is optional, with it the shaders get compiled in and the game runs faster.</string>
    <string name="update">Update</string>
    <string name="game">Game</string>
    <string name="mods_title">Code mods</string>
    <string name="mods_body">Pick the folder with your mods (the one that has 0004000000126300 in it). Only code mods matter here: code.bin, code.ips or code.bps. Skip this to play unmodded.</string>
    <string name="output_body">libmh4u_code_native.so and its .id are saved here. Pick the same folder you use in MH4U for Android.</string>
