    <string name="welcome_title">Üdv a MH4U Builderben</string>
    <string name="welcome_body">Lefordítja a MH4U for Android natív kódkönyvtárát a saját dumpodból, közvetlenül a telefonon. Adj hozzá kódmodokat, fordítsd újra, játssz. Semmi sem kerül feltöltésre.</string>
    <string name="perm_title">Engedélyek</string>
    <string name="perm_body">A fájlhozzáféréssel a dump közvetlenül a tárhelyről olvasható, a könyvtár pedig a MH4U mappádba kerül. Az értesítések mutatják a haladást, amíg mást csinálsz.</string>
    <string name="all_files">Hozzáférés minden fájlhoz</string>
    <string name="notifications">Értesítések</string>
    <string name="dump_title">A dumpod</string>
    <string name="dump_body">Válaszd ki a visszafejtett v1.3.0 frissítést (.cia). Az alapjáték (.3ds / .cci) nem kötelező; vele a shaderek is lefordulnak, és a játék gyorsabb.</string>
    <string name="update">Frissítés</string>
    <string name="game">Játék</string>
    <string name="mods_title">Kódmodok</string>
    <string name="mods_body">Válaszd ki a modok mappáját (amelyikben 0004000000126300 van). Itt csak a kódmodok számítanak: code.bin, code.ips vagy code.bps. Hagyd ki, ha mod nélkül játszol.</string>
    <string name="output_body">Ide kerül a libmh4u_code_native.so és a hozzá tartozó .id. Ugyanazt a mappát válaszd, amit a MH4U for Androidban használsz.</string>
