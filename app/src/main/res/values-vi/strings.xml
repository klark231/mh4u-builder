    <string name="welcome_title">Chào mừng đến với MH4U Builder</string>
    <string name="welcome_body">Biên dịch thư viện mã gốc cho MH4U for Android từ bản dump của chính bạn, ngay trên điện thoại. Thêm mod mã, biên dịch lại, chơi. Không có gì được tải lên.</string>
    <string name="perm_title">Quyền</string>
    <string name="perm_body">Quyền truy cập tệp cho phép đọc bản dump trực tiếp từ bộ nhớ và đặt thư viện vào thư mục MH4U của bạn. Thông báo hiển thị tiến trình khi bạn làm việc khác.</string>
    <string name="all_files">Truy cập tất cả tệp</string>
    <string name="notifications">Thông báo</string>
    <string name="dump_title">Bản dump của bạn</string>
    <string name="dump_body">Chọn bản cập nhật v1.3.0 đã giải mã (.cia). Game gốc (.3ds / .cci) là tùy chọn; có nó thì shader được biên dịch kèm và game chạy nhanh hơn.</string>
    <string name="update">Bản cập nhật</string>
    <string name="game">Game</string>
    <string name="mods_title">Mod mã</string>
    <string name="mods_body">Chọn thư mục mod của bạn (thư mục có 0004000000126300 bên trong). Ở đây chỉ mod mã mới có tác dụng: code.bin, code.ips hoặc code.bps. Bỏ qua nếu chơi không mod.</string>
    <string name="output_body">libmh4u_code_native.so và tệp .id được lưu ở đây. Chọn đúng thư mục bạn dùng trong MH4U for Android.</string>
